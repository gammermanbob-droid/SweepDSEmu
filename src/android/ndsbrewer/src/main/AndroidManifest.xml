<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The SAF tree grant from the profile-directory picker only covers
         DocumentFile/ContentResolver access; ForwarderBuilder/
         ForwarderRegistry/NdsRom use plain java.io.File on the resolved
         real path instead (see PathUtil's "primary:" trick), which needs
         this too, for the same reason as the main SweepDSEmu app's own
         MANAGE_EXTERNAL_STORAGE use (see GrantMissingFilesystemPermission
         Fragment there). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Signature-level permissions still have to be explicitly requested
         like any other; the matching signature only changes whether the
         request is silently approved instead of prompting/denying, it
         doesn't grant it implicitly. -->
    <uses-permission android:name="org.citra.citra_emu.permission.INSTALL_CIA_BRIDGE" />

    <application
        android:name=".NdsBrewerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.NdsBrewer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
