<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <SurfaceView
            android:id="@+id/surface_ds_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <SurfaceView
            android:id="@+id/surface_ds_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Touch button overlay populated programmatically in
         DsEmulationActivity, reusing the same button artwork as the 3DS
         side's InputOverlay (see buildButtonOverlay's doc comment) in a
         fixed (non-draggable, non-per-game-configurable) layout. -->
    <FrameLayout
        android:id="@+id/ds_button_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
